# Drizzle
DATABASE_URL=local.db

# Somnia Shannon Testnet (chain id 50312)
PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
PUBLIC_VAULT_FACTORY_ADDRESS=0x6EbBD76076faE4FBaD7C4B5bc9c8c6feeB82e4a9
# Required ERC-20 used as createVault `asset` (USDso). Open vault fails closed if unset.
PUBLIC_VAULT_ASSET_ADDRESS=
# Optional server-only RPC override
# SOMNIA_RPC_URL=

# bot-performance indexer (bun run bot:performance). Read-only; run beside the web app.
# STATS_INTERVAL_MS=30000
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# examples/dreamdex-vault-bot (bun run bot:dreamdex). Operator key is CLI-only — never PUBLIC_*.
# VAULT_ADDRESS=
# OPERATOR_PRIVATE_KEY=
# DRY_RUN=true
# TAKE_INTERVAL_MS=8000
# TAKE_MAX_SHARES=5
# OF_EDGE=0.03
# OF_MAX_DISAGREEMENT=0.1
# OF_MAX_EXPOSURE=50
# OF_COOLDOWN_MS=30000
# OPERATOR_ID=
# PRICE_FEED_URL=https://price-feed.dev.oracle.somnia.host/v1/graphql
# EC_UNDERLYING=
# EC_INTERVAL=15m
# PNL_INTERVAL_MS=30000
# VAULT_SEED_TUSDC=50
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
